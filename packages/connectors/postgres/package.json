{
  "name": "@easysql/connector-postgres",
  "version": "2.1.0",
  "description": "EasySQL PostgreSQL connector — local schema introspection and query execution. Credentials never leave the process.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "author": "Clearsoft <contact@clearsoft.net>",
  "homepage": "https://easysql.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clearsoft-net/easysql-js.git",
    "directory": "packages/connectors/postgres"
  },
  "bugs": {
    "url": "https://github.com/Clearsoft-net/easysql-js/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "easysql",
    "clearsoft",
    "postgres",
    "postgresql",
    "connector",
    "introspection",
    "sql"
  ],
  "license": "MIT",
  "dependencies": {
    "pg": "^8.13.1",
    "@easysql/common": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  }
}
