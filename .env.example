# EasySQL API Configuration
EASYSQL_API_URL=https://api.easysql.net

# Authentication is OIDC-only — tokens come from the sign-in flow.
# Set EASYSQL_ACCESS_TOKEN directly, or EASYSQL_REFRESH_TOKEN to rotate on startup.
# EASYSQL_ACCESS_TOKEN=
# EASYSQL_REFRESH_TOKEN=

# Used by the samples (see samples/README.md)
# EASYSQL_CONNECTION_ID=
# EASYSQL_SQLITE_FILE=

# Connector integration tests (each suite is skipped when its variables are unset)
# EASYSQL_TEST_MYSQL_URL=mysql://user:pass@127.0.0.1:3306/easysql_test
# EASYSQL_TEST_POSTGRES_URL=postgresql://user:pass@127.0.0.1:5432/easysql_test
# EASYSQL_TEST_CLICKHOUSE_URL=clickhouse://default:pass@127.0.0.1:8123/easysql_test
# EASYSQL_TEST_SQLSERVER_URL=sqlserver://sa:pass@127.0.0.1:1433/easysql_test
# EASYSQL_TEST_ORACLE_URL=oracle://user:pass@127.0.0.1:1521/FREEPDB1
# EASYSQL_TEST_FIREBIRD_URL=firebird://user:pass@127.0.0.1:3050//data/easysql_test.fdb
# EASYSQL_TEST_DB2_URL=db2://user:pass@127.0.0.1:50000/easysql_test
# EASYSQL_TEST_DUCKDB_FILE=./easysql_test.duckdb
# EASYSQL_TEST_LIBSQL_URL=libsql://your-db.turso.io
# EASYSQL_TEST_LIBSQL_TOKEN=
# EASYSQL_TEST_TRINO_URL=trino://user@127.0.0.1:8080/tpch
# EASYSQL_TEST_HANA_URL=hana://user:pass@127.0.0.1:30015
# EASYSQL_TEST_SNOWFLAKE_URL=snowflake://user:pass@account/db
# EASYSQL_TEST_BIGQUERY_PROJECT=
# EASYSQL_TEST_BIGQUERY_DATASET=
# EASYSQL_TEST_D1_ACCOUNT_ID=
# EASYSQL_TEST_D1_DATABASE_ID=
# EASYSQL_TEST_D1_API_TOKEN=
