        { "name": "bio", "dataType": "text", "nullable": true, "ordinal": 7 },
        { "name": "created_at", "dataType": "timestamp", "nullable": false, "defaultValue": "CURRENT_TIMESTAMP", "ordinal": 8 }
      ]
    },
    {
      "name": "posts",
      "rowsApprox": 128,
      "columns": [
        { "name": "id", "dataType": "bigint", "nullable": false, "primaryKey": true, "ordinal": 1 },
