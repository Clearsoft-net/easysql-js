    "./bigquery": {
      "types": "./dist/bigquery/index.d.ts",
      "import": "./dist/bigquery/index.js"
    },
    "./trino": {
      "types": "./dist/trino/index.d.ts",
      "import": "./dist/trino/index.js"
    },
    "./hana": {
      "types": "./dist/hana/index.d.ts",
      "import": "./dist/hana/index.js"
