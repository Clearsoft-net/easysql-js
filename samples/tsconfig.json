{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@easysql/common": ["../packages/common/src/index.ts"],
      "@easysql/client": ["../packages/client/src/index.ts"],
