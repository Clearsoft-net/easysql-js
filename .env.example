# EasySQL API Configuration
EASYSQL_API_URL=https://api.easysql.net

# Authentication is OIDC-only — tokens come from the sign-in flow.
# Set EASYSQL_ACCESS_TOKEN directly, or EASYSQL_REFRESH_TOKEN to rotate on startup.
# EASYSQL_ACCESS_TOKEN=
# EASYSQL_REFRESH_TOKEN=

# Used by the samples (see samples/README.md)
# EASYSQL_CONNECTOR_ID=
# EASYSQL_SQLITE_FILE=

# Connector integration tests (skipped when unset)
# EASYSQL_TEST_MYSQL_URL=mysql://user:pass@127.0.0.1:3306/easysql_test
# EASYSQL_TEST_POSTGRES_URL=postgresql://user:pass@127.0.0.1:5432/easysql_test
# EASYSQL_TEST_CLICKHOUSE_URL=clickhouse://default:pass@127.0.0.1:8123/easysql_test
