{
  "name": "@easysql/connectors",
  "version": "4.1.0",
  "description": "EasySQL database connectors with optional, on-demand drivers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mysql": {
      "types": "./dist/mysql/index.d.ts",
