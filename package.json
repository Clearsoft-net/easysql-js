{
  "name": "@clearsoft/easysql-sdk",
  "version": "0.1.0",
  "description": "EasySQL API TypeScript SDK — Ask questions in natural language to your MySQL, MariaDB or PostgreSQL databases.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "prepublish": "bun run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "easysql",
    "sql",
    "nlp",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.5.0"
  }
}
